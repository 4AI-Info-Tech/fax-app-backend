{
	"name": "form-assistant",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:staging": "wrangler deploy --env staging",
		"deploy:prod": "wrangler deploy --env prod",
		"dry-run:staging": "wrangler deploy --env staging --dry-run",
		"dry-run:prod": "wrangler deploy --env prod --dry-run",
		"dev": "wrangler dev",
		"test": "vitest"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.50.2"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.8.19",
		"vitest": "~3.2.0",
		"wrangler": "^4.23.0"
	}
}
